# ==============================================================================
# EchoVal AI Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your actual credentials.
# Do not commit .env to version control.

# OpenAI API Key (Required for Scanner Agent deal extraction)
OPENAI_API_KEY=your_openai_api_key_here

# Pushover Mobile Push Notification Credentials (Optional)
# Sign up at https://pushover.net to obtain your User Key and App API Token
PUSHOVER_USER=your_pushover_user_key_here
PUSHOVER_TOKEN=your_pushover_app_token_here

# Twilio SMS Credentials (Optional fallback for text alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM=your_twilio_phone_number_here
MY_PHONE_NUMBER=your_destination_phone_number_here

# Modal Configuration (Optional override - defaults to modal credentials)
# MODAL_TOKEN_ID=your_modal_token_id_here
# MODAL_TOKEN_SECRET=your_modal_token_secret_here
